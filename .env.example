# Copier ce fichier en .env et renseigner les vraies valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore) car il contient des secrets.

DJANGO_SECRET_KEY=change-moi
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=likelemba.pythonanywhere.com

# --- Email SMTP (ex: Gmail) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=ton-adresse@gmail.com
# Pour Gmail, utiliser un "mot de passe d'application" (pas le mot de passe du compte)
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=ton-adresse@gmail.com

# --- WhatsApp via Twilio (laisser vide pour désactiver l'envoi réel) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Notifications push (Web Push / PWA installée) ---
# Clés déjà générées pour ce projet — les laisser vides utilise celles par
# défaut définies dans settings.py. Ne les régénérer que si nécessaire :
# `python manage.py generate_vapid_keys`, ce qui invalide les abonnements existants.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=contact@decouvrir-kinshasa.cd

